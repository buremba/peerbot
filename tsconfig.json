{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // Bundler mode for root application
    "moduleResolution": "bundler", 
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true
  },
  "include": ["src/**/*", "test/**/*"],
  "exclude": ["node_modules", "packages", "base-action"]
}
