[0.000, "o", "\u001b[1mNext steps:\u001b[22m\r\n\u001b[1m\u001b[22m\r\n\u001b[36m  1. cd my-agent\u001b[39m\r\n"]
[0.000, "o", "\u001b[36m  2. Start the local stack: lobu run (uses PGlite by default)\u001b[39m\r\n"]
[0.000, "o", "\u001b[2m       Optional: set DATABASE_URL in .env to use external Postgres instead.\u001b[22m\r\n"]
[0.000, "o", "\u001b[36m  3. API docs: http://localhost:8787/api/docs\u001b[39m\r\n\u001b[2m\u001b[22m\r\n\u001b[2m  See README.md for layout, AGENTS.md for the agent contract.\u001b[22m\r\n\u001b[2m\u001b[22m\r\n"]
[0.001, "o", "\u001b[?25h"]
