le\"\n          },\n          \"status\": {\n            \"type\": \"string\",\n            \"enum\": [\n              \"current\",\n              \"draft\"\n            ],\n            \"default\": \"current\",\n            \"description\": \"Status (draft for unpublished)\"\n          },\n          \"parentId\": {\n            \"type\": \"string\",\n            \"description\": \"ID of the parent to nest the new page under. Accepts the ID of any container that can hold a page — a page, folder, whiteboard, database, embed, o…2028 tokens truncated…       },\n          \"outwardIssue\": {\n            \"type\": \"string\",\n            \"description\": \"Outward issue key (e.g. MKY-1).\"\n          },\n          \"type\": {\n            \"type\": \"string\",\n            \"description\": \"Link type name (e.g. Duplicate, Blocks, Clones, Relates). Use getIssueLinkTypes to list available types.\"\n          },\n          \"comment\": {\n            \"type\": \"string\",\n            \"description\": \"Optional comment on the outward issue.\"\n          },\n          \"contentFormat\": {\n            \"type\": \"string\",\n            \"enum\": [\n              \"markdown\",\n              \"adf\"\n            ],\n            \"description\": \"Content format for body content. Use \\\"markdown\\\" for simplified plain text. Use \\\"adf\\\" (Atlassian Document Format, JSON) for full programmatic fidelity. Defaults vary by tool when omitted.\"\n          }\n        },\n        \"required\": [\n          \"cloudId\",\n          \"inwardIssue\",\n          \"outwardIssue\",\n          \"type\"\n        ],\n        \"additionalProperties\": false,\n        \"$schema\": \"http://json-schema.org/draft-07/schema#\"\n      }\n    },\n    {\n      \"key\": null,\n      \"name\": \"GetCompassComponents\",\n      \"display_name\": null,\n      \"kind\": \"read\",\n      \"action_mode\": null,\n      \"description\": \"Get a list of Compass components\",\n      \"input_schema\": {\n