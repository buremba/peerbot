",\\n            \\\"tool_args\\\": {\\n              \\\"attempt\\\": 1\\n            },\\n            \\\"tool_result\\\": {\\n              \\\"success\\\": true\\n            },\\n            \\\"created_at\\\": \\\"2026-08-13T03:45:07.878Z\\\"\\n          },\\n          {\\n            \\\"id\\\": 1350,\\n            \\\"reaction_type\\\": \\\"notification_sent\\\",\\n            \\\"tool_name\\\": \\\"notify\\\",\\n            \\\"tool_args\\\": {\\n              \\\"title\\\": \\\"Lobu production activity digest\\\",\\n              \\\"recipients\\\": \\\"admins\\\"\\n            },\\n            \\\"created_at\\\": \\\"2026-08-13T03:45:07.871Z\\\"\\n          }\\n        ]\\n      }\\n    ],\\n    \\\"behavior\\\": {\\n      \\\"behavior_id\\\": \\\"99\\\",\\n      \\\"behavior_name\\\": \\\"Lobu production activity digest\\\",\\n      \\\"slug\\\": \\\"product-activity-digest\\\",\\n      \\\"status\\\": \\\"active\\\",\\n      \\\"triggers\\\": [\\n        {\\n          \\\"cron\\\": \\\"5,25,45 * * * *\\\",\\n          \\\"kind\\\": \\\"schedule\\\",\\n          \\\"timezone\\\": null,\\n          \\\"execution\\\": \\\"window\\\",\\n          \\\"active_run\\\": \\\"coalesce\\\",\\n          \\\"skip_if_unchanged\\\": true\\n        }\\n      ],\\n      \\\"next_run_at\\\": \\\"2026-08-13T04:05:00.000Z\\\",\\n      \\\"agent_id\\\": \\\"product-ops\\\",\\n      \\\"device_worker_id\\\": null,\\n      \\\"agent_kind\\\": null,\\n      \\\"version\\\": 2,\\n      \\\"sources\\\": [\\n        {\\n          \\\"name\\\": \\\"product_activity\\\",\\n          \\\"query\\\": \\\"@connection:lobu-product-activity-db\\\"\\n        },\\n        {\\n          \\\"name\\\": \\\"kubernetes_logs\\\",\\n          \\\"query\\\": \\\"@connection:lobu-production-logs\\\"\\n        }\\n      ],\\n      \\\"prompt\\\": \\\"The reaction sends the exact activity rows for this window. Return exactly {\\\\\\\"run\\\\\\\":true}.\\\",\\n      \\\"description\\\": \\\"Every 20 minutes, summarize new signups, logins, connections, MCP clients, and Kubernetes log activity; stay silent when nothing happened.\\\",\\n      \\\"reactions_guidance\\\": \\\"Send one rich digest containing every user email and activity detail in the window. Send nothing when both sources are empty.\\\",\\n      \\\"reaction_script\\\": \\\"import type {\\\\n  CardElement,\\\\n  ReactionClient,\\\\n  ReactionContext,\\\\n} from \\\\\\\"@lobu/connector-sdk\\\\\\\";\\\\n\\\\nconst PRODUCT_ACTIVITY_CONNECTION = \\\\\\\"lobu-product-activity-db\\\\\\\";\\\\nconst LOG_ACTIVITY_CONNECTION = \\\\\\\"lobu-production-logs\\\\\\\";\\\\nconst CARD_TEXT_LIMIT = 2_800;\\\\n\\\\nexport const input = {\\\\n  type: \\\\\\\"object\\\\\\\",\\\\n  properties: {\\\\n    run: { type: \\\\\\\"boolean\\\\\\\" },\\\\n  },\\\\n  required: [\\\\\\\"run\\\\\\\"],\\\\n};\\\\n\\\\ninterface ActivityRow {\\\\n  connection_slug: string;\\\\n  title?: string | null;\\\\n  payload_text?: string | null;\\\\n  metadata?: unknown;\\\\n  source_url?: string | null;\\\\n}\\\\n\\\\ninterface PreviousDigestRow {\\\\n  created_at: string;\\\\n}\\\\n\\\\ninterface LogActivity {\\\\n  errors?: number;\\\\n  warnings?: number;\\\\n  error_samples?: string[];\\\\n  warning_samples?: string[];\\\\n}\\\\n\\\\nexport interface ProductActivityDigest {\\\\n  signups: string[];\\\\n  logins: string[];\\\\n  connections: string[];\\\\n  mcp_conversations: string[];\\\\n  errors: number;\\\\n  warnings: number;\\\\n  error_samples: string[];\\\\n  warning_samples: string[];\\\\n  logs_url: string | null;\\\\n}\\\\n\\\\nexport function collectProductActivityDigest(\\\\n  rows: ActivityRow[]\\\\n): ProductActivityDigest {\\\\n  const digest: ProductActivityDigest = {\\\\n    signups: [],\\\\n    logins: [],\\\\n    connections: [],\\\\n    mcp_conversations: [],\\\\n    errors: 0,\\\\n    warnings: 0,\\\\n    error_samples: [],\\\\n    warning_samples: [],\\\\n    logs_url: null,\\\\n  };\\\\n\\\\n  for (const row of rows) {\\\\n    if (row.connection_slug === PRODUCT_ACTIVITY_CONNECTION) {\\\\n      const text = row.payload_text?.trim();\\\\n      if (!text) continue;\\\\n      if (row.title === \\\\\\\"New signup\\\\\\\") digest.signups.push(text);\\\\n      if (row.title === \\\\\\\"User login\\\\\\\") digest.logins.push(text);\\\\n      if (row.title === \\\\\\\"New connection\\\\\\\") digest.connections.push(text);\\\\n      if (row.title === \\\\\\\"MCP activity\\\\\\\") digest.mcp_conversations.push(text);\\\\n      continue;\\\\n    }\\\\n\\\\n    if (row.connection_slug === LOG_ACTIVITY_CONNECTION) {\\\\n      const activity = record(row.metadata) as unknown as LogActivity;\\\\n      digest.errors += finiteCount(activity.errors);\\\\n      digest.warnings += finiteCount(activity.warnings);\\\\n      digest.error_samples.push(...stringArray(activity.error_samples));\\\\n      digest.warning_samples.push(...stringArray(activity.warning_samples));\\\\n      if (row.source_url) digest.logs_url = row.source_url;\\\\n    }\\\\n  }\\\\n\\\\n  digest.error_samples = [...new Set(digest.error_samples)];\\\\n  digest.warning_samples = [...new Set(digest.warning_samples)];\\\\n  return digest;\\\\n}\\\\n\\\\nexport function hasProductActivity(digest: ProductActivityDigest): boolean {\\\\n  return (\\\\n    digest.signups.length > 0 ||\\\\n    digest.logins.length > 0 ||\\\\n    digest.connections.length > 0 ||\\\\n    digest.mcp_conversations.length > 0 ||\\\\n    digest.errors > 0 ||\\\\n    digest.warnings > 0\\\\n  );\\\\n}\\\\n\\\\nexport function buildProductActivityCard(\\\\n  digest: ProductActivityDigest,\\\\n  window: { start: string; end: string }\\\\n): CardElement {\\\\n  const online = uniqueUsers([...digest.logins, ...digest.mcp_conversations]);\\\\n  const children: CardElement[] = [\\\\n    {\\\\n      type: \\\\\\\"fields\\\\\\\",\\\\n      children: [\\\\n        field(\\\\\\\"Signups\\\\\\\", digest.signups.length),\\\\n        field(\\\\\\\"Login sessions\\\\\\\", digest.logins.length),\\\\n        field(\\\\\\\"Online users\\\\\\\", online.length),\\\\n        field(\\\\\\\"New connections\\\\\\\", digest.connections.length),\\\\n        field(\\\\\\\"Active MCP conversations\\\\\\\", digest.mcp_conversations.length),\\\\n        field(\\\\\\\"Errors / warnings\\\\\\\", `${digest.errors} / ${digest.warnings}`),\\\\n      ],\\\\n    },\\\\n  ];\\\\n\\\\n  appendSection(children, \\\\\\\"New signups\\\\\\\", digest.signups.map(safe));\\\\n  appendSection(children, \\\\\\\"Online users\\\\\\\", online.map(safe));\\\\n  appendSection(children, \\\\\\\"New connections\\\\\\\", digest.connections.map(safe));\\\\n  appendSection(\\\\n    children,\\\\n    \\\\\\\"Active MCP conversations\\\\\\\",\\\\n    digest.mcp_conversations.map(safe)\\\\n  );\\\\n  appendSection(children, \\\\\\\"Recent errors\\\\\\\", digest.error_samples.map(safe));\\\\n  appendSection(children, \\\\\\\"Recent warnings\\\\\\\", digest.warning_samples.map(safe));\\\\n  if (digest.logs_url) {\\\\n    children.push({\\\\n      type: \\\\\\\"actions\\\\\\\",\\\\n      children: [\\\\n        {\\\\n          type: \\\\\\\"link-button\\\\\\\",\\\\n          url: digest.logs_url,\\\\n          label: \\\\\\\"Open production logs\\\\\\\",\\\\n        },\\\\n      ],\\\\n    });\\\\n  }\\\\n\\\\n  return {\\\\n    type: \\\\\\\"card\\\\\\\",\\\\n    title: \\\\\\\"Lobu production activity\\\\\\\",\\\\n    subtitle: formatWindow(window.start, window.end),\\\\n    children,\\\\n  };\\\\n}\\\\n\\\\nfunction field(label: string, value: string | number): CardElement {\\\\n  return { type: \\\\\\\"field\\\\\\\", label, value: String(value) };\\\\n}\\\\n\\\\nfunction appendSection(\\\\n  children: CardElement[],\\\\n  heading: string,\\\\n  values: string[]\\\\n): void {\\\\n  if (values.length === 0) return;\\\\n  children.push({ type: \\\\\\\"divider\\\\\\\" });\\\\n  for (const content of chunkText(\\\\n    `**${heading} (${values.length})**\\\\\\\\n${values.map((value) => `• ${value}`).join(\\\\\\\"\\\\\\\\n\\\\\\\")}`\\\\n  )) {\\\\n    children.push({ type: \\\\\\\"text\\\\\\\", content });\\\\n  }\\\\n}\\\\n\\\\nfunction chunkText(value: string): string[] {\\\\n  const lines = value.split(\\\\\\\"\\\\\\\\n\\\\\\\");\\\\n  const chunks: string[] = [];\\\\n  let current = \\\\\\\"\\\\\\\";\\\\n  for (const line of lines) {\\\\n    const candidate = current ? `${current}\\\\\\\\n${line}` : line;\\\\n    if (candidate.length <= CARD_TEXT_LIMIT) {\\\\n      current = candidate;\\\\n      continue;\\\\n    }\\\\n    if (current) chunks.push(current);\\\\n    current = line.slice(0, CARD_TEXT_LIMIT);\\\\n  }\\\\n  if (current) chunks.push(current);\\\\n  return chunks;\\\\n}\\\\n\\\\nfunction uniqueUsers(rows: string[]): string[] {\\\\n  const users = new Map<string, string>();\\\\n  for (const row of rows) {\\\\n    const email = row.match(/\\\\\\\\b[A-Z0-9._%+-]+@[A-Z0-9.-]+\\\\\\\\.[A-Z]{2,}\\\\\\\\b/i)?.[0];\\\\n    users.set(email?.toLowerCase() ?? row, row);\\\\n  }\\\\n  return [...users.values()];\\\\n}\\\\n\\\\nfunction formatWindow(start: string, end: string): string {\\\\n  const startDate = new Date(start);\\\\n  const endDate = new Date(end);\\\\n  if (\\\\n    !Number.isFinite(startDate.getTime()) ||\\\\n    !Number.isFinite(endDate.getTime())\\\\n  ) {\\\\n    return `${start} → ${end}`;\\\\n  }\\\\n  const formatter = new Intl.DateTimeFormat(\\\\\\\"en-GB\\\\\\\", {\\\\n    day: \\\\\\\"2-digit\\\\\\\",\\\\n    month: \\\\\\\"short\\\\\\\",\\\\n    year: \\\\\\\"numeric\\\\\\\",\\\\n    hour: \\\\\\\"2-digit\\\\\\\",\\\\n    minute: \\\\\\\"2-digit\\\\\\\",\\\\n    hourCycle: \\\\\\\"h23\\\\\\\",\\\\n    timeZone: \\\\\\\"UTC\\\\\\\",\\\\n  });\\\\n  return `${formatter.format(startDate)} → ${formatter.format(endDate)} UTC`;\\\\n}\\\\n\\\\nfunction summaryBody(\\\\n  digest: ProductActivityDigest,\\\\n  window: { start: string; end: string }\\\\n): string {\\\\n  return (\\\\n    `${formatWindow(window.start, window.end)} · ` +\\\\n    `${digest.signups.length} signups · ` +\\\\n    `${digest.logins.length} login sessions · ` +\\\\n    `${uniqueUsers([...digest.logins, ...digest.mcp_conversations]).length} online users · ` +\\\\n    `${digest.connections.length} new connections · ` +\\\\n    `${digest.mcp_conversations.length} active MCP conversations · ` +\\\\n    `${digest.errors} errors · ${digest.warnings} warnings`\\\\n  );\\\\n}\\\\n\\\\nfunction safe(value: string): string {\\\\n  return value\\\\n    .replaceAll(\\\\\\\"&\\\\\\\", \\\\\\\"&amp;\\\\\\\")\\\\n    .replaceAll(\\\\\\\"<\\\\\\\", \\\\\\\"&lt;\\\\\\\")\\\\n    .replaceAll(\\\\\\\">\\\\\\\", \\\\\\\"&gt;\\\\\\\");\\\\n}\\\\n\\\\nfunction record(value: unknown): Record<string, unknown> {\\\\n  if (value && typeof value === \\\\\\\"object\\\\\\\") {\\\\n    return value as Record<string, unknown>;\\\\n  }\\\\n  if (typeof value === \\\\\\\"string\\\\\\\") {\\\\n    try {\\\\n      const parsed = JSON.parse(value) as unknown;\\\\n      if (parsed && typeof parsed === \\\\\\\"object\\\\\\\") {\\\\n        return parsed as Record<string, unknown>;\\\\n      }\\\\n    } catch {\\\\n      return {};\\\\n    }\\\\n  }\\\\n  return {};\\\\n}\\\\n\\\\nfunction finiteCount(value: unknown): number {\\\\n  const count = Number(value ?? 0);\\\\n  return Number.isFinite(count) && count > 0 ? count : 0;\\\\n}\\\\n\\\\nfunction stringArray(value: unknown): string[] {\\\\n  return Array.isArray(value)\\\\n    ? value.filter((item): item is string => typeof item === \\\\\\\"string\\\\\\\")\\\\n    : [];\\\\n}\\\\n\\\\nexport default async (\\\\n  ctx: ReactionContext,\\\\n  client: ReactionClient\\\\n): Promise<void> => {\\\\n  const runId = Number(ctx.window.run_id);\\\\n  if (!Number.isSafeInteger(runId) || runId <= 0) {\\\\n    throw new Error(\\\\\\\"Product activity digest requires a durable run id\\\\\\\");\\\\n  }\\\\n\\\\n  // Sub-hour schedules share a daily Canvas window. Use the last delivered\\\\n  // digest as a durable cursor so every newly ingested row is reported once.\\\\n  const previousRows = (await client.query(`\\\\n    SELECT created_at\\\\n    FROM events\\\\n    WHERE behavior_id = ${ctx.window.behavior_id}\\\\n      AND semantic_type = 'notification'\\\\n      AND title = 'Lobu production activity digest'\\\\n    ORDER BY created_at DESC, id DESC\\\\n    LIMIT 1\\\\n  `)) as PreviousDigestRow[];\\\\n  const end = new Date();\\\\n  const previous = previousRows[0]?.created_at\\\\n    ? new Date(previousRows[0].created_at)\\\\n    : new Date(end.getTime() - 20 * 60 * 1000);\\\\n  const start = Number.isFinite(previous.getTime())\\\\n    ? previous\\\\n    : new Date(end.getTime() - 20 * 60 * 1000);\\\\n\\\\n  const rows = (await client.query(`\\\\n    SELECT\\\\n      c.slug AS connection_slug,\\\\n      e.title,\\\\n      e.payload_text,\\\\n      e.metadata,\\\\n      e.source_url\\\\n    FROM events e\\\\n    JOIN connections c ON c.id = e.connection_id\\\\n    WHERE c.slug IN ('${PRODUCT_ACTIVITY_CONNECTION}', '${LOG_ACTIVITY_CONNECTION}')\\\\n      AND e.created_at > '${start.toISOString()}'::timestamptz\\\\n      AND e.created_at <= '${end.toISOString()}'::timestamptz\\\\n    ORDER BY e.created_at ASC, e.id ASC\\\\n    LIMIT 5000\\\\n  `)) as ActivityRow[];\\\\n  const digest = collectProductActivityDigest(rows);\\\\n  if (!hasProductActivity(digest)) {\\\\n    client.log(\\\\\\\"No production activity; Slack digest skipped\\\\\\\", {\\\\n      window_start: start.toISOString(),\\\\n      window_end: end.toISOString(),\\\\n    });\\\\n    return;\\\\n  }\\\\n\\\\n  await client.notifications.send({\\\\n    title: \\\\\\\"Lobu production activity digest\\\\\\\",\\\\n    body: summaryBody(digest, {\\\\n      start: start.toISOString(),\\\\n      end: end.toISOString(),\\\\n    }),\\\\n    card: buildProductActivityCard(digest, {\\\\n      start: start.toISOString(),\\\\n      end: end.toISOString(),\\\\n    }),\\\\n    recipients: \\\\\\\"admins\\\\\\\",\\\\n    idempotency_key: `product-activity-digest:run:${runId}`,\\\\n    behavior_source: {\\\\n      behavior_id: ctx.window.behavior_id,\\\\n      window_id: ctx.window.id,\\\\n    },\\\\n  });\\\\n};\\\\n\\\",\\n      \\\"behavior_run\\\": {\\n        \\\"run_id\\\": 937209,\\n        \\\"status\\\": \\\"running\\\",\\n        \\\"created_at\\\": \\\"2026-08-13T03:48:02.159Z\\\",\\n        \\\"completed_at\\\": null\\n      },\\n      \\\"health\\\": \\\"healthy\\\",\\n      \\\"last_scheduling_error\\\": null,\\n      \\\"last_run_outcome\\\": null\\n    },\\n    \\\"pending_analysis\\\": {\\n      \\\"unprocessed_count\\\": 0,\\n      \\\"next_window\\\": null,\\n      \\\"next_action\\\": null\\n    },\\n    \\\"pagination\\\": {\\n      \\\"page\\\": 1,\\n      \\\"page_size\\\": 50,\\n      \\\"total\\\": 1\\n    },\\n    \\\"metadata\\\": {\\n      \\\"query_type\\\": \\\"specific\\\",\\n      \\\"date_range\\\": {\\n        \\\"content_since\\\": null,\\n        \\\"content_until\\\": null\\n      },\\n      \\\"granularity_filter\\\": null,\\n      \\\"granularity_actual\\\": null,\\n      \\\"granularity_fallback_used\\\": false\\n    },\\n    \\\"view_url\\\": \\\"https://app.lobu.ai/lobu-team/behaviors/99\\\"\\n  }\\n}\\n```\"\n    }\n  ],\n  \"structuredContent\": {\n    \"success\": true,\n    \"skipped_calls\": 0,\n    \"side_effect_preview\": [],\n    \"dry_run\": false,\n    \"return_value\": {\n      \"windows\": [\n        {\n          \"window_id\": 5045230,\n          \"behavior_id\": \"99\",\n          \"behavior_name\": \"Lobu production activity digest\",\n          \"granularity\": \"daily\",\n          \"window_start\": \"2026-08-12T00:00:00.000Z\",\n          \"window_end\": \"2026-08-13T00:00:00.000Z\",\n          \"content_analyzed\": 25,\n          \"extracted_data\": {\n            \"run\": true\n          },\n          \"model_used\": \"lobu-agent\",\n          \"run_metadata\": {\n            \"agent_id\": \"product-ops\",\n            \"executor\": \"lobu-agent\",\n            \"window_end\": \"2026-08-13T00:00:00.000Z\",\n            \"behavior_id\": 99,\n            \"window_start\": \"2026-08-12T00:00:00.000Z\",\n            \"watcher_run_id\": 937111,\n            \"dispatch_source\": \"manual\",\n            \"session_agent_id\": \"product-ops_watcher_99_run_937111\"\n          },\n          \"execution_time_ms\": 53120,\n          \"created_at\": \"2026-08-13T03:45:07.716Z\",\n          \"version_id\": 306,\n          \"reactions\": [\n            {\n              \"id\": 1351,\n              \"reaction_type\": \"script_execution\",\n              \"tool_name\": \"reaction_executor\",\n              \"tool_args\": {\n                \"attempt\": 1\n              },\n              \"tool_result\": {\n                \"success\": true\n              },\n              \"created_at\": \"2026-08-13T03:45:07.878Z\"\n            },\n            {\n              \"id\": 1350,\n              \"reaction_type\": \"notification_sent\",\n              \"tool_name\": \"notify\",\n              \"tool_args\": {\n                \"title\": \"Lobu production activity digest\",\n                \"recipients\": \"admins\"\n              },\n              \"created_at\": \"2026-08-13T03:45:07.871Z\"\n            }\n          ]\n        }\n      ],\n      \"behavior\": {\n        \"behavior_id\": \"99\",\n        \"behavior_name\": \"Lobu production activity digest\",\n        \"slug\": \"product-activity-digest\",\n        \"status\": \"active\",\n        \"triggers\": [\n          {\n            \"cron\": \"5,25,45 * * * *\",\n            \"kind\": \"schedule\",\n            \"timezone\": null,\n            \"execution\": \"window\",\n            \"active_run\": \"coalesce\",\n            \"skip_if_unchanged\": true\n          }\n        ],\n        \"next_run_at\": \"2026-08-13T04:05:00.000Z\",\n        \"agent_id\": \"product-ops\",\n        \"device_worker_id\": null,\n        \"agent_kind\": null,\n        \"version\": 2,\n        \"sources\": [\n          {\n            \"name\": \"product_activity\",\n            \"query\": \"@connection:lobu-product-activity-db\"\n          },\n          {\n            \"name\": \"kubernetes_logs\",\n            \"query\": \"@connection:lobu-production-logs\"\n          }\n        ],\n        \"prompt\": \"The reaction sends the exact activity rows for this window. Return exactly {\\\"run\\\":true}.\",\n        \"description\": \"Every 20 minutes, summarize new signups, logins, connections, MCP clients, and Kubernetes log activity; stay silent when nothing happened.\",\n        \"reactions_guidance\": \"Send one rich digest containing every user email and activity detail in the window. Send nothing when both sources are empty.\",\n        \"reaction_script\": \"import type {\\n  CardElement,\\n  ReactionClient,\\n  ReactionContext,\\n} from \\\"@lobu/connector-sdk\\\";\\n\\nconst PRODUCT_ACTIVITY_CONNECTION = \\\"lobu-product-activity-db\\\";\\nconst LOG_ACTIVITY_CONNECTION = \\\"lobu-production-logs\\\";\\nconst CARD_TEXT_LIMIT = 2_800;\\n\\nexport const input = {\\n  type: \\\"object\\\",\\n  properties: {\\n    run: { type: \\\"boolean\\\" },\\n  },\\n  required: [\\\"run\\\"],\\n};\\n\\ninterface ActivityRow {\\n  connection_slug: string;\\n  title?: string | null;\\n  payload_text?: string | null;\\n  metadata?: unknown;\\n  source_url?: string | null;\\n}\\n\\ninterface PreviousDigestRow {\\n  created_at: string;\\n}\\n\\ninterface LogActivity {\\n  errors?: number;\\n  warnings?: number;\\n  error_samples?: string[];\\n  warning_samples?: string[];\\n}\\n\\nexport interface ProductActivityDigest {\\n  signups: string[];\\n  logins: string[];\\n  connections: string[];\\n  mcp_conversations: string[];\\n  errors: number;\\n  warnings: number;\\n  error_samples: string[];\\n  warning_samples: string[];\\n  logs_url: string | null;\\n}\\n\\nexport function collectProductActivityDigest(\\n  rows: ActivityRow[]\\n): ProductActivityDigest {\\n  const digest: ProductActivityDigest = {\\n    signups: [],\\n    logins: [],\\n    connections: [],\\n    mcp_conversations: [],\\n    errors: 0,\\n    warnings: 0,\\n    error_samples: [],\\n    warning_samples: [],\\n    logs_url: null,\\n  };\\n\\n  for (const row of rows) {\\n    if (row.connection_slug === PRODUCT_ACTIVITY_CONNECTION) {\\n      const text = row.payload_text?.trim();\\n      if (!text) continue;\\n      if (row.title === \\\"New signup\\\") digest.signups.push(text);\\n      if (row.title === \\\"User login\\\") digest.logins.push(text);\\n      if (row.title === \\\"New connection\\\") digest.connections.push(text);\\n      if (row.title === \\\"MCP activity\\\") digest.mcp_conversations.push(text);\\n      continue;\\n    }\\n\\n    if (row.connection_slug === LOG_ACTIVITY_CONNECTION) {\\n      const activity = record(row.metadata) as unknown as LogActivity;\\n      digest.errors += finiteCount(activity.errors);\\n      digest.warnings += finiteCount(activity.warnings);\\n      digest.error_samples.push(...stringArray(activity.error_samples));\\n      digest.warning_samples.push(...stringArray(activity.warning_samples));\\n      if (row.source_url) digest.logs_url = row.source_url;\\n    }\\n  }\\n\\n  digest.error_samples = [...new Set(digest.error_samples)];\\n  digest.warning_samples = [...new Set(digest.warning_samples)];\\n  return digest;\\n}\\n\\nexport function hasProductActivity(digest: ProductActivityDigest): boolean {\\n  return (\\n    digest.signups.length > 0 ||\\n    digest.logins.length > 0 ||\\n    digest.connections.length > 0 ||\\n    digest.mcp_conversations.length > 0 ||\\n    digest.errors > 0 ||\\n    digest.warnings > 0\\n  );\\n}\\n\\nexport function buildProductActivityCard(\\n  digest: ProductActivityDigest,\\n  window: { start: string; end: string }\\n): CardElement {\\n  const online = uniqueUsers([...digest.logins, ...digest.mcp_conversations]);\\n  const children: CardElement[] = [\\n    {\\n      type: \\\"fields\\\",\\n      children: [\\n        field(\\\"Signups\\\", digest.signups.length),\\n        field(\\\"Login sessions\\\", digest.logins.length),\\n        field(\\\"Online users\\\", online.length),\\n        field(\\\"New connections\\\", digest.connections.length),\\n        field(\\\"Active MCP conversations\\\", digest.mcp_conversations.length),\\n        field(\\\"Errors / warnings\\\", `${digest.errors} / ${digest.warnings}`),\\n      ],\\n    },\\n  ];\\n\\n  appendSection(children, \\\"New signups\\\", digest.signups.map(safe));\\n  appendSection(children, \\\"Online users\\\", online.map(safe));\\n  appendSection(children, \\\"New connections\\\", digest.connections.map(safe));\\n  appendSection(\\n    children,\\n    \\\"Active MCP conversations\\\",\\n    digest.mcp_conversations.map(safe)\\n  );\\n  appendSection(children, \\\"Recent errors\\\", digest.error_samples.map(safe));\\n  appendSection(children, \\\"Recent warnings\\\", digest.warning_samples.map(safe));\\n  if (digest.logs_url) {\\n    children.push({\\n      type: \\\"actions\\\",\\n      children: [\\n        {\\n          type: \\\"link-button\\\",\\n          url: digest.logs_url,\\n          label: \\\"Open production logs\\\",\\n        },\\n      ],\\n    });\\n  }\\n\\n  return {\\n    type: \\\"card\\\",\\n    title: \\\"Lobu production activity\\\",\\n    subtitle: formatWindow(window.start, window.end),\\n    children,\\n  };\\n}\\n\\nfunction field(label: string, value: string | number): CardElement {\\n  return { type: \\\"field\\\", label, value: String(value) };\\n}\\n\\nfunction appendSection(\\n  children: CardElement[],\\n  heading: string,\\n  values: string[]\\n): void {\\n  if (values.length === 0) return;\\n  children.push({ type: \\\"divider\\\" });\\n  for (const content of chunkText(\\n    `**${heading} (${values.length})**\\\\n${values.map((value) => `• ${value}`).join(\\\"\\\\n\\\")}`\\n  )) {\\n    children.push({ type: \\\"text\\\", content });\\n  }\\n}\\n\\nfunction chunkText(value: string): string[] {\\n  const lines = value.split(\\\"\\\\n\\\");\\n  const chunks: string[] = [];\\n  let current = \\\"\\\";\\n  for (const line of lines) {\\n    const candidate = current ? `${current}\\\\n${line}` : line;\\n    if (candidate.length <= CARD_TEXT_LIMIT) {\\n      current = candidate;\\n      continue;\\n    }\\n    if (current) chunks.push(current);\\n    current = line.slice(0, CARD_TEXT_LIMIT);\\n  }\\n  if (current) chunks.push(current);\\n  return chunks;\\n}\\n\\nfunction uniqueUsers(rows: string[]): string[] {\\n  const users = new Map<string, string>();\\n  for (const row of rows) {\\n    const email = row.match(/\\\\b[A-Z0-9._%+-]+@[A-Z0-9.-]+\\\\.[A-Z]{2,}\\\\b/i)?.[0];\\n    users.set(email?.toLowerCase() ?? row, row);\\n  }\\n  return [...users.values()];\\n}\\n\\nfunction formatWindow(start: string, end: string): string {\\n  const startDate = new Date(start);\\n  const endDate = new Date(end);\\n  if (\\n    !Number.isFinite(startDate.getTime()) ||\\n    !Number.isFinite(endDate.getTime())\\n  ) {\\n    return `${start} → ${end}`;\\n  }\\n  const formatter = new Intl.DateTimeFormat(\\\"en-GB\\\", {\\n    day: \\\"2-digit\\\",\\n    month: \\\"short\\\",\\n    year: \\\"numeric\\\",\\n    hour: \\\"2-digit\\\",\\n    minute: \\\"2-digit\\\",\\n    hourCycle: \\\"h23\\\",\\n    timeZone: \\\"UTC\\\",\\n  });\\n  return `${formatter.format(startDate)} → ${formatter.format(endDate)} UTC`;\\n}\\n\\nfunction summaryBody(\\n  digest: ProductActivityDigest,\\n  window: { start: string; end: string }\\n): string {\\n  return (\\n    `${formatWindow(window.start, window.end)} · ` +\\n    `${digest.signups.length} signups · ` +\\n    `${digest.logins.length} login sessions · ` +\\n    `${uniqueUsers([...digest.logins, ...digest.mcp_conversations]).length} online users · ` +\\n    `${digest.connections.length} new connections · ` +\\n    `${digest.mcp_conversations.length} active MCP conversations · ` +\\n    `${digest.errors} errors · ${digest.warnings} warnings`\\n  );\\n}\\n\\nfunction safe(value: string): string {\\n  return value\\n    .replaceAll(\\\"&\\\", \\\"&amp;\\\")\\n    .replaceAll(\\\"<\\\", \\\"&lt;\\\")\\n    .replaceAll(\\\">\\\", \\\"&gt;\\\");\\n}\\n\\nfunction record(value: unknown): Record<string, unknown> {\\n  if (value && typeof value === \\\"object\\\") {\\n    return value as Record<string, unknown>;\\n  }\\n  if (typeof value === \\\"string\\\") {\\n    try {\\n      const parsed = JSON.parse(value) as unknown;\\n      if (parsed && typeof parsed === \\\"object\\\") {\\n        return parsed as Record<string, unknown>;\\n      }\\n    } catch {\\n      return {};\\n    }\\n  }\\n  return {};\\n}\\n\\nfunction finiteCount(value: unknown): number {\\n  const count = Number(value ?? 0);\\n  return Number.isFinite(count) && count > 0 ? count : 0;\\n}\\n\\nfunction stringArray(value: unknown): string[] {\\n  return Array.isArray(value)\\n    ? value.filter((item): item is string => typeof item === \\\"string\\\")\\n    : [];\\n}\\n\\nexport default async (\\n  ctx: ReactionContext,\\n  client: ReactionClient\\n): Promise<void> => {\\n  const runId = Number(ctx.window.run_id);\\n  if (!Number.isSafeInteger(runId) || runId <= 0) {\\n    throw new Error(\\\"Product activity digest requires a durable run id\\\");\\n  }\\n\\n  // Sub-hour schedules share a daily Canvas window. Use the last delivered\\n  // digest as a durable cursor so every newly ingested row is reported once.\\n  const previousRows = (await client.query(`\\n    SELECT created_at\\n    FROM events\\n    WHERE behavior_id = ${ctx.window.behavior_id}\\n      AND semantic_type = 'notification'\\n      AND title = 'Lobu production activity digest'\\n    ORDER BY created_at DESC, id DESC\\n    LIMIT 1\\n  `)) as PreviousDigestRow[];\\n  const end = new Date();\\n  const previous = previousRows[0]?.created_at\\n    ? new Date(previousRows[0].created_at)\\n    : new Date(end.getTime() - 20 * 60 * 1000);\\n  const start = Number.isFinite(previous.getTime())\\n    ? previous\\n    : new Date(end.getTime() - 20 * 60 * 1000);\\n\\n  const rows = (await client.query(`\\n    SELECT\\n      c.slug AS connection_slug,\\n      e.title,\\n      e.payload_text,\\n      e.metadata,\\n      e.source_url\\n    FROM events e\\n    JOIN connections c ON c.id = e.connection_id\\n    WHERE c.slug IN ('${PRODUCT_ACTIVITY_CONNECTION}', '${LOG_ACTIVITY_CONNECTION}')\\n      AND e.created_at > '${start.toISOString()}'::timestamptz\\n      AND e.created_at <= '${end.toISOString()}'::timestamptz\\n    ORDER BY e.created_at ASC, e.id ASC\\n    LIMIT 5000\\n  `)) as ActivityRow[];\\n  const digest = collectProductActivityDigest(rows);\\n  if (!hasProductActivity(digest)) {\\n    client.log(\\\"No production activity; Slack digest skipped\\\", {\\n      window_start: start.toISOString(),\\n      window_end: end.toISOString(),\\n    });\\n    return;\\n  }\\n\\n  await client.notifications.send({\\n    title: \\\"Lobu production activity digest\\\",\\n    body: summaryBody(digest, {\\n      start: start.toISOString(),\\n      end: end.toISOString(),\\n    }),\\n    card: buildProductActivityCard(digest, {\\n      start: start.toISOString(),\\n      end: end.toISOString(),\\n    }),\\n    recipients: \\\"admins\\\",\\n    idempotency_key: `product-activity-digest:run:${runId}`,\\n    behavior_source: {\\n      behavior_id: ctx.window.behavior_id,\\n      window_id: ctx.window.id,\\n    },\\n  });\\n};\\n\",\n        \"behavior_run\": {\n          \"run_id\": 937209,\n          \"status\": \"running\",\n          \"created_at\": \"2026-08-13T03:48:02.159Z\",\n          \"completed_at\": null\n        },\n        \"health\": \"healthy\",\n        \"last_scheduling_error\": null,\n        \"last_run_outcome\": null\n      },\n      \"pending_analysis\": {\n        \"unprocessed_count\": 0,\n        \"next_window\": null,\n        \"next_action\": null\n      },\n      \"pagination\": {\n        \"page\": 1,\n        \"page_size\": 50,\n        \"total\": 1\n      },\n      \"metadata\": {\n        \"query_type\": \"specific\",\n        \"date_range\": {\n          \"content_since\": null,\n          \"content_until\": null\n        },\n        \"granularity_filter\": null,\n        \"granularity_actual\": null,\n        \"granularity_fallback_used\": false\n      },\n      \"view_url\": \"https://app.lobu.ai/lobu-team/behaviors/99\"\n    }\n  }\n}\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"019ff8a2-6289-7163-9249-f7ccb2880c20"}}}
