\n            ],\n            \"description\": \"Content format for page/comment body. Use \\\"html\\\" to write or read Confluence content as structured HTML. HTML supports standard blocks plus Confluence HTML+ data-type nodes: panels, status, task/decision lists, expands, layouts, cards, media, dates, mentions, macros/extensions, and sync blocks. HTML is round-trip safe and preserves inline comments and existing local IDs. It must follow valid ADF nesting rules: inline-only task/decision items, headings, and captions; no self-nesting panels, expands, tables, or blockquotes. Invalid HTML will be rejected with a descriptive error so you can retry. Use \\\"markdown\\\" for simplified plain text. Defaults vary by tool when omitted.\"\n          },\n          \"versionMessage\": {\n            \"type\": \"string\",\n            \"description\": \"Version message\"\n          },\n          \"includeBody\": {\n            \"type\": \"boolean\",\n            \"default\": false,\n            \"description\": \"If true, include the page body in the response; if false, omit it to reduce payload size.\"\n          }\n        },\n        \"required\": [\n          \"cloudId\",\n          \"pageId\",\n          \"body\"\n        ],\n        \"additionalProperties\": false,\n        \"$schema\": \"http://json-schema.org/draft-07/schema#\"\n      }\n    },\n    {\n      \"key\": null,\n      \"name\": \"CreateConfluenceFooterComment\",\n      \"display_name\": null,\n      \"kind\": \"write\",\n      \"action_mode\": null,\n      \"description\": \"Create a footer comment on a page or blog post\",\n      \"input_schema\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"cloudId\": {\n            \"type\": \"string\",\n            \"description\": \"Cloud ID (UUID or site URL)\"\n          },\n          \"pageId\": {\n            \"type\": \"string\",\n            \"description\": \"Page or blog post ID, or a Confluence tiny link ID (the encoded part from /