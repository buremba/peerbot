omment:confluence\nwrite:comment:confluence\nread:space:confluence\nread:hierarchical-content:confluence\nwrite:component:compass\nread:component:compass\nread:scorecard:compass\nwrite:scorecard:compass\nread:event:compass\nread:metric:compass\nread:all:twg\nwrite:all:twg\nCancel\nContinue\nDisplay Name\nLink to entities (optional)All entities\n\nTag this connection with entities so it shows up under each entity's Connections.\n\nAssign to Member (optional)\nSelect member...\n\nLeave empty to make this connection available to everyone in the organization.\n\nSelect or create an mcp.mcp-atlassian-com account profile first.\nAdd connection"}],"isError":false,"_meta":{"browser_use":{"url":"https://app.lobu.ai/buremba/connectors/create/mcp.mcp-atlassian-com"},"codex/browserUse":true,"codex/toolSurface":{"backend":"chrome","browserId":"-8634-4783-8e6a-e39607db0408","extensionInstanceId":"1637f493-157c-4f11-8e25-85c837091ab5","kind":"browserUse","openTabIds":["558587812","558587839","558587860","558587875","558587895"],"openTabs":[{"id":558587812,"title":"Authorize App","url":"https://auth.atlassian.com"},{"id":558587839,"title":"Board - KAN board - Jira","url":"https://testfgdfgdfg.atlassian.net"},{"id":558587860,"title":"Atlassian Rovo MCP server - testfgdfgdfg - Atlassian Administration","url":"https://admin.atlassian.com"},{"id":558587875,"title":"Authorize App","url":"https://auth.atlassian.com"},{"id":558587895,"title":"Lobu","url":"https://app.lobu.ai"}],"screenshot":{"pageUrl":"https://app.lobu.ai","tabId":"558587895","url":"data:image/jpeg;base64,"}}}},"duration":{"secs":0,"nanos":672029208}},"started_at_ms":1786588220924,"completed_at_ms":1786588221597}}
